{
  "version": 2,
  "builds": [
    {
      "src": "api/submit-exam.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/submit-exam",
      "dest": "/api/submit-exam.py"
    },
    {
      "src": "/api/student/exam/submit",
      "dest": "/api/submit-exam.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    }
  ]
}
